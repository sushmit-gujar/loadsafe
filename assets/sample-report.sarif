              "shortDescription": {
                "text": "Chat template with template-injection patterns"
              },
              "fullDescription": {
                "text": "A Jinja chat template (GGUF tokenizer.chat_template or tokenizer_config.json) uses dunder attribute access or imports; such templates achieved RCE in loaders that rendered them without a sandbox (e.g. CVE-2024-34359)."
              },
              "help": {
                "text": "A Jinja chat template (GGUF tokenizer.chat_template or tokenizer_config.json) uses dunder attribute access or imports; such templates achieved RCE in loaders that rendered them without a sandbox (e.g. CVE-2024-34359).",
