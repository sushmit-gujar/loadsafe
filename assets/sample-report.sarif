          "rules": [
            {
              "id": "LS100",
              "name": "DangerousCallableInvokedDuringUnpickling",
              "shortDescription": {
                "text": "Dangerous callable invoked during unpickling"
              },
              "fullDescription": {
                "text": "The pickle stream calls (REDUCE/INST/OBJ/NEWOBJ) a callable that can execute code, spawn processes, touch the network or the filesystem. Loading this file runs it."
              },
              "help": {
                "text": "The pickle stream calls (REDUCE/INST/OBJ/NEWOBJ) a callable that can execute code, spawn processes, touch the network or the filesystem. Loading this file runs it.",
                "markdown": "The pickle stream calls (REDUCE/INST/OBJ/NEWOBJ) a callable that can execute code, spawn processes, touch the network or the filesystem. Loading this file runs it.\n\n**Remediation:** Do not load. Obtain the model in safetensors or rebuild it from a trusted source.\n\nOWASP LLM: LLM03:2025 Supply Chain, LLM04:2025 Data and Model Poisoning  \nMITRE ATLAS: AML.T0010.003, AML.T0011.000, AML.T0018.002  \nCWE: CWE-502"
              },
              "helpUri": "https://github.com/sushmit-gujar/loadsafe#rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "LLM03:2025 Supply Chain",
                  "LLM04:2025 Data and Model Poisoning",
                  "AML.T0010.003 AI Supply Chain Compromise: Model",
                  "AML.T0011.000 User Execution: Unsafe AI Artifacts",
                  "AML.T0018.002 Manipulate AI Model: Embed Malware",
                  "external/cwe/cwe-502"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "LS107",
